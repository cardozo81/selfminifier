; Modelo oficial de configuração persistente V2 do SelfMinifier.
; O arquivo real do usuário não deve ser versionado.

[Configuracao]
VersaoSchema=2
Motor=esbuild
Perfil=Padrao
ModoSaida=BackupESobrescreverOriginais
PastaRaiz=C:\Projetos\MeuSite
TiposArquivo=CSS+JavaScript
IgnorarPasta01=node_modules
IgnorarPasta02=.git
IgnorarPasta03=vendor
IgnorarArquivo01=src\config.js
